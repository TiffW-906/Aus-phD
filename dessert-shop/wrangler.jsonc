{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wud-dessert",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wud-dessert-orders",
      // 執行 `npx wrangler d1 create wud-dessert-orders` 後，把回傳的 id 貼在這裡
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
